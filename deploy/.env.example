# Copy to /opt/weglow/deploy/.env on the server and fill in. Never commit the real file.

# Uzum Checkout — from the Uzum Bank manager (test first, then production)
UZUM_CHECKOUT_URL=
UZUM_TERMINAL_ID=
UZUM_API_KEY=

# Uzum Nasiya — token from the Uzum Nasiya manager (leave empty to hide installments)
NASIYA_BASE_URL=https://merchants-api.uzumnasiya.uz
NASIYA_TOKEN=

# Password for https://weglow.uz/manager/ — long random string
ADMIN_KEY=

PUBLIC_URL=https://pay.weglow.uz
SITE_URL=https://weglow.uz
CORS_ORIGINS=https://weglow.uz,https://www.weglow.uz

# Telegram notifications about payments (bot from @BotFather + chat id)
TG_BOT_TOKEN=
TG_CHAT_ID=
